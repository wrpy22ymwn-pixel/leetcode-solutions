#example:
#input:[1,2,3,4]
#output:[1,2,3,5]
class Solution(object):
    def plusOne(self, digits):
        p = 1
        if digits[-1] != 9:
            digits[-1] = digits[-1] + 1
        else:
            if len(digits) == 1:
                return [1, 0]
            for i in range(-1, (-len(digits)-1),-1):
                if digits[i] == 9 and p == 1 and i != -len(digits):
                    digits[i] = 0
                    p = 1
                elif digits[i] == 9 and p == 1 and i == -len(digits):
                    digits[i] = 0
                    digits = [1] + digits
                elif digits[i] != 9 and p == 1:
                    digits[i] += 1
                    break
        return digits
