#Функция проверяет правильно ли закрыты скобки
#Чтобы проверить это,идем по строке,если указатель на открывающей скобке,то добавляем в массив opened
#Если указатель на закрывающей,то проверяем,чтобы последняя скобка в массиве подходила нашей скобке и тогда
#удаляем из массива скобку
class Solution(object):
    def isValid(self, s):
        a='[{('
        b=']})'
        if len(s)%2!=0:
            return False#если длина нечетная,то одна из скобок точно не мэтчится
        opened=[]
        for i in range(len(s)):
            if s[i] in a:
                opened=opened+[s[i]]
            else:
                if len(opened)==0:return False
                if s[i]=='}':
                    if opened[-1]=='{':
                        opened = opened[:-1]
                    else:
                        return False
                if s[i]==')':
                    if opened[-1]=='(':
                        opened = opened[:-1]
                    else:
                        return False
                if s[i]==']':
                    if opened[-1]=='[':
                        opened = opened[:-1]
                    else:
                        return False
        if len(opened)==0:
            return True
        return False
